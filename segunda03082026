function runTests() {
  let passados = 0;
  let falhados = 0;

  function assert(nome, recebido, esperado) {
    const recStr = JSON.stringify(recebido);
    const espStr = JSON.stringify(esperado);
    if (recStr === espStr) {
      console.log(`✅ PASSOU: ${nome}`);
      passados++;
    } else {
      console.log(`❌ FALHOU: ${nome}`);
      console.log(`   Esperado: ${espStr}`);
      console.log(`   Recebido: ${recStr}`);
      falhados++;
    }
  }

  console.log("== INICIANDO TESTES DE SEGUNDA ==\n");

  // Testes 1
  assert("separarLicaoDiaria - isolando os 5 minutos de estudo", 
    separarLicaoDiaria({ aplicativo: "Duolingo", idioma: "Inglês", tempo: "5 minutos", ofensiva: 245 }), 
    ["5 minutos", { aplicativo: "Duolingo", idioma: "Inglês", ofensiva: 245 }]
  );

  // Testes 2
  assert("juntarAcordesViolao - unindo a cifra", 
    juntarAcordesViolao(["Em", "C"], ["G", "D"]), 
    ["Em", "C", "G", "D"]
  );

  // Testes 3
  assert("contarVitoriasLoL - contando as vitórias na ranqueada", 
    contarVitoriasLoL(["Vitória", "Derrota", "Vitória", "Vitória", "Derrota"], "Vitória"), 
    3
  );

  // Testes 4
  assert("analisarPontuacoes - contando números pares", 
    analisarPontuacoes([10, 15, 20, 25, 30], true), 
    3 // (10, 20, 30)
  );

  assert("analisarPontuacoes - contando números ímpares", 
    analisarPontuacoes([10, 15, 20, 25, 30], false), 
    2 // (15, 25)
  );

  console.log(`\n== RESULTADO: ${passados} PASSARAM, ${falhados} FALHARAM ==`);
}

// Executa os testes automaticamente
runTests();