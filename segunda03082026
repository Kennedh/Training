// -----------------------------------------------------------------------------
// 1. Object Destructuring + Rest
// -----------------------------------------------------------------------------
export function separarLicaoDiaria(licao) {
  // TODO: O objeto 'licao' tem informações do seu estudo (idioma, tempo, xp, etc).
  // Extraia APENAS a propriedade 'tempo' usando desestruturação.
  // Guarde o restante no operador Rest.
  // Retorne um array: [tempo, restoDaLicao]
  
  const { tempo, ...restoDaLicao } = licao;
  return [tempo, restoDaLicao];
}

// -----------------------------------------------------------------------------
// 2. Array Spread
// -----------------------------------------------------------------------------
export function juntarAcordesViolao(intro, refrao) {
  // TODO: Você tem dois arrays com acordes de uma música.
  // Use o Spread Operator (...) para juntar os acordes da intro e do refrão em uma lista só.
  // Retorne o novo array.
  
  return [...intro, ...refrao];
}

// -----------------------------------------------------------------------------
// 3. Iteração com .forEach
// -----------------------------------------------------------------------------
export function contarVitoriasLoL(historicoPartidas, resultadoBuscado) {
  // TODO: 'historicoPartidas' é um array de strings (ex: ["Vitória", "Derrota", "Vitória"]).
  // Use o método .forEach() para iterar sobre o array e contar quantas vezes 
  // o 'resultadoBuscado' aparece.
  // Retorne o número total (a contagem).
  
  let contagem = 0;
  
  historicoPartidas.forEach(partida => {
    if (partida === resultadoBuscado) {
      contagem++;
    }
  });
  
  return contagem;
}

// -----------------------------------------------------------------------------
// 4. Iteração com for...of + Lógica condicional
// -----------------------------------------------------------------------------
export function analisarPontuacoes(pontos, buscarPares) {
  // TODO: 'pontos' é um array de números. 'buscarPares' é um booleano (true ou false).
  // Use um loop 'for...of' para percorrer os 'pontos'.
  // Se 'buscarPares' for true, conte quantos números são PARES (n % 2 === 0).
  // Se 'buscarPares' for false, conte quantos números são ÍMPARES (n % 2 !== 0).
  // Retorne a contagem final usando apenas uma variável de resultado (como você fez no último exercício!).
  
  let contagem = 0;
  
  for (const ponto of pontos) {
    const isPar = ponto % 2 === 0;
    
    if ((buscarPares && isPar) || (!buscarPares && !isPar)) {
      contagem++;
    }
  }
  
  return contagem;
}

